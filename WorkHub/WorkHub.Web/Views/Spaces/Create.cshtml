@using WorkHub.Application.Dtos.Space
@model AddSpaceRequest

@{
    ViewBag.Title = "Create Space"; 
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form asp-controller="Spaces" asp-action="Create" method="post">
    @Html.AntiForgeryToken(); 
 <input asp-for="SpaceNumber"  /> 
 <textarea asp-for="Description"  ></textarea> 
 <select asp-for="Type"  asp-items="ViewBag.SpaceTypeSelectList">
    <option value="" selected>Select Space Type</option>
 </select>

 <input asp-for="MinCapacity"  /> 
 <input asp-for="MaxCapacity"  /> 
 <input asp-for="HourlyPrice"  /> 
 <input asp-for="DailyPrice"   name="DailyPrice"/> 


 <button type="submit">Save</button>

<div asp-validation-summary="All"></div>

</form>