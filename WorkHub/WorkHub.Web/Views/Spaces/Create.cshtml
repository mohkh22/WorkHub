@using WorkHub.Application.ViewModels
@model CreateSpaceViewModel

@{
    ViewBag.Title = "Create Space"; 
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form asp-controller="Spaces" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
 <input asp-for="AddSpaceRequest.SpaceNumber"  /> 
 <textarea asp-for="AddSpaceRequest.Description"  ></textarea> 
 <select asp-for="AddSpaceRequest.Type"  asp-items="ViewBag.SpaceTypeSelectList">
    <option value="" selected>Select Space Type</option>
 </select>

 <input asp-for="AddSpaceRequest.MinCapacity"  /> 
 <input asp-for="AddSpaceRequest.MaxCapacity"  /> 
 <input asp-for="AddSpaceRequest.HourlyPrice"  /> 
 <input asp-for="AddSpaceRequest.DailyPrice"  /> 

 <select asp-for="AddSpaceRequest.FeatureIds" multiple>
    @foreach (var feature in Model.FeatureResponses)
    {
        <option value="@feature.Id">@feature.Name</option>
    }
 </select>
 <button type="submit">Save</button>

<div asp-validation-summary="All"></div>

</form>