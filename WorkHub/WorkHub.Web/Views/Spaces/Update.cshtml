@using WorkHub.Application.ViewModels
@model UpdateSpaceViewModel
@{
    ViewBag.Title = "Update Space"; 
}

<form asp-controller="Spaces" asp-action="Update" method="post">
    @Html.AntiForgeryToken();
    <input value="@ViewBag.SpaceId" name="id" hidden="hidden" />
    <input asp-for="UpdateSpaceRequest.SpaceNumber"  />
    <textarea asp-for="UpdateSpaceRequest.Description" ></textarea>

    <select asp-for="UpdateSpaceRequest.Type" asp-items="ViewBag.SpaceTypeSelectList">
        <option value="" selected>Select Space Type</option>
    </select>

    <input asp-for="UpdateSpaceRequest.MinCapacity" />
    <input asp-for="UpdateSpaceRequest.MaxCapacity" />
    <input asp-for="UpdateSpaceRequest.HourlyPrice" />
    <input asp-for="UpdateSpaceRequest.DailyPrice"  />
    
    <select asp-for="UpdateSpaceRequest.FeatureIds" multiple>
        @foreach (var feature in Model.FeatureResponses)
        {
            if (Model.UpdateSpaceRequest.FeatureIds.Contains(feature.Id)){
                
              <option value="@feature.Id" selected>@feature.Name</option>
            }
          else
            {
               <option value="@feature.Id">@feature.Name</option>
            }
        }
    </select>

    <button type="submit" >Save</button>

    <div asp-validation-summary="All"></div>

</form>