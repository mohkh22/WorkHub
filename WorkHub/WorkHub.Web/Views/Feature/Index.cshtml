@using WorkHub.Application.Dtos.Feature
@model IEnumerable<FeatureResponse>
@{
    ViewBag.Title="Features"; 
}

<table>
    <tr>
        <th>Name </th>
        <th>Description </th>
        <th>Actions</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>
                <a asp-controller="Feature" asp-action="Update" asp-route-Id="@item.Id">Edit</a>
                <a asp-controller="Feature" asp-action="Delete" asp-route-Id="@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>